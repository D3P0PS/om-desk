{
  "name": "omapp",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Unofficial Android app for OpenMarket (openmarket.xyz) with background price alerts.",
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs --tests && node --test .tmp-tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "sync": "node build.mjs && npx cap sync android",
    "apk": "node build.mjs && npx cap sync android && cd android && ./gradlew assembleDebug",
    "release": "scripts/release.sh",
    "publish": "scripts/publish-release.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/preferences": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/node": "^22.20.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
